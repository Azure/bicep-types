{
  "name": "@azure/bicep-types",
  "version": "0.0.0-placeholder",
  "description": "Utility library to simplify reading & writing types in a format that Bicep understands.",
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run",
    "test:fix": "BASELINE_RECORD=true vitest run",
    "package": "nbgv-setversion && npm run build && npm pack && nbgv-setversion --reset",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix"
  },
  "files": [
    "/lib"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Azure/bicep-types"
  },
  "readme": "https://github.com/Azure/bicep-types/readme.md",
  "keywords": [
    "autorest",
    "bicep"
  ],
  "main": "lib/src/index.js",
  "exports": {
    ".": "./lib/src/index.js"
  },
  "types": "lib/src/index.d.ts",
  "author": "Microsoft Corporation",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Azure/bicep-types/issues"
  },
  "homepage": "https://github.com/Azure/bicep-types/blob/main/README.md",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "eslint": "^8.23.1",
    "eslint-plugin-header": "^3.1.1",
    "nerdbank-gitversioning": "^3.5.113",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
